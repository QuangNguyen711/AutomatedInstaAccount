# For docker-compose (service name "db" as host). For local `uv run` outside
# Docker, change the host to localhost and run `docker compose up -d db` first.
DATABASE_URL=postgresql+asyncpg://placesfinder:placesfinder@db:5432/placesfinder

CACHE_TTL_DAYS=14
DEFAULT_SEARCH_RADIUS_M=3000
# Each detail page costs ~20-40s (headed browser, review + review-photo scraping) — a
# first-time search of a new area takes roughly MAX_DETAIL_PAGES * 30s. Keep these two EQUAL:
# any place beyond MAX_DETAIL_PAGES only gets its listing thumbnail (no reviews, no summary),
# so a mismatch produces a mix of fully-enriched and half-empty cards in the same result set.
MAX_CRAWL_RESULTS=8
MAX_DETAIL_PAGES=8

# Not currently read by ranking (see RankingService/SummaryService — relevance comes from a
# query-aware LLM match score below, not embedding similarity). Left here in case embeddings
# get reintroduced later; infrastructure/embedding/ still has the provider.
EMBEDDING_ENABLED=false
EMBEDDING_API_URL=https://integrate.api.nvidia.com/v1/embeddings
EMBEDDING_MODEL_NAME=nvidia/nv-embedqa-e5-v5
EMBEDDING_API_KEY=

# NVIDIA-hosted Nemotron (OpenAI-compatible /chat/completions) — powers both the per-place
# query-match summary/score and the Maps-search-query simplification (see SummaryService,
# QueryRewriteService). Required for real ranking; falls back to distance-only otherwise.
LLM_ENABLED=true
LLM_API_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b
LLM_REASONING_ENABLED=false
LLM_API_KEY=

# Required to get reviews at all — Google serves a "limited view" (no reviews) to
# logged-out/automated sessions. Run a one-time interactive Google login (headed browser,
# save context.storage_state()) and point this at the saved file. Gitignored (.secrets/).
GOOGLE_AUTH_STATE_PATH=.secrets/google_auth_state.json

YOLO_WEIGHTS_PATH=backend/infrastructure/vision/weights/best_cls.pt

RANKING_WEIGHT_RELEVANCE=0.6
RANKING_WEIGHT_DISTANCE=0.4
